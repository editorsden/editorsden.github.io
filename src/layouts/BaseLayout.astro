---
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import SubmitModal from '../components/SubmitModal.astro';
import { withBase } from '../lib/path';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeTab?: string;
}

const {
  title = 'Editors Den — The Editors Archive',
  description = 'Curated software, plugins, tutorials, and hidden gems for video editors, colorists, and post-production professionals.',
  activeTab = ''
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts for Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body class="h-full min-h-screen flex flex-col justify-between selection:bg-cyan-500 selection:text-white relative overflow-x-hidden bg-tech-grid font-sans text-slate-900 bg-white">
    <!-- Ambient glowing light pools -->
    <div class="cyan-core-glow pointer-events-none absolute inset-0 z-0"></div>
    <div class="cyan-top-glow pointer-events-none absolute top-0 left-0 right-0 h-96 z-0"></div>

    <!-- Frosted Glass Floating Capsule Header -->
    <Header activeTab={activeTab} />

    <!-- Main Panoramic Content Area -->
    <main class="relative z-10 flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="relative z-20 w-full py-8 mt-16 flex justify-center">
      <p class="inline-flex items-center gap-1.5 font-sans text-[11px] text-slate-200 tracking-wide px-4 py-1.5 rounded-full bg-slate-800 border border-slate-700">
        Made with Love <span class="text-red-400">❤️</span> By Prince Yadav
      </p>
    </footer>

    <!-- Global Command Palette (Cmd + K) -->
    <CommandPalette />

    <!-- Global Tool Submission Modal -->
    <SubmitModal />
  </body>
</html>
