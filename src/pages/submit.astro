---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Plus, Code, ExternalLink, ArrowLeft, Copy, Sparkles, Terminal } from '@lucide/astro';
import GithubIcon from '../components/GithubIcon.astro';
import { withBase } from '../lib/path';

const categories = [
  'Format Ingestion',
  'Automation & AI',
  'Audio Repair & Cleanup',
  'Color Grading & VFX',
  'Workflow & Organization',
  'Subtitling & Transcription',
  'Export & Compression'
];
---

<BaseLayout
  title="Submit a Tool or Script — Editors Den"
  description="Contribute a post-production plugin, workflow extension, or FFmpeg/Python script to the Editors Den archive."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-10">
    <!-- Back to Archive Link -->
    <div>
      <a 
        href={withBase('/')} 
        class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-cyan-700 transition-colors"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Back to Archive</span>
      </a>
    </div>

    <!-- Header Banner -->
    <div class="space-y-3 pb-8 border-b border-cyan-500/20">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-cyan-50 border border-cyan-200/80 text-cyan-800">
        <Sparkles class="w-3 h-3 text-cyan-500" />
        <span>Community Contributions</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
        Add to the Editors Den Archive
      </h1>

      <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed font-sans">
        Whether you built an indie Premiere extension, discovered an obscure OpenFX demuxer, or crafted a life-saving FFmpeg proxy script, submit it here so thousands of post-production editors can benefit.
      </p>
    </div>

    <!-- Submission Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Option 1: GitHub Issue Template (Fast Track) -->
      <div class="p-6 sm:p-7 rounded-[24px] bg-white/90 backdrop-blur-xl border border-cyan-500/20 space-y-4 flex flex-col justify-between shadow-xs hover:border-cyan-400/40 transition-all">
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-slate-900 font-semibold text-sm font-display">
            <GithubIcon class="w-4 h-4 text-slate-700" />
            <span>Fast-Track: GitHub Issue Form</span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed font-sans">
            Fill out our standardized GitHub Issue Form. Our maintainers will verify the software, test compatibility, and merge the entry directly into the archive repository.
          </p>
        </div>

        <div class="pt-4 space-y-2.5">
          <a
            href="https://github.com/editorsden/editorsden.github.io/issues/new?template=tool_submission.yml"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2.5 text-xs font-medium text-white bg-slate-900 hover:bg-cyan-600 rounded-full transition-colors shadow-xs"
          >
            <span>Submit Tool via GitHub Form</span>
            <ExternalLink class="w-3.5 h-3.5" />
          </a>

          <a
            href="https://github.com/editorsden/editorsden.github.io/issues/new?template=dev_hub_submission.yml"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2 text-xs font-medium text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-200 rounded-full transition-colors"
          >
            <span>Submit Dev Hub Script</span>
            <ExternalLink class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Option 2: Pull Request Method -->
      <div class="p-6 sm:p-7 rounded-[24px] bg-white/90 backdrop-blur-xl border border-cyan-500/20 space-y-4 flex flex-col justify-between shadow-xs hover:border-cyan-400/40 transition-all">
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-slate-900 font-semibold text-sm font-display">
            <Code class="w-4 h-4 text-slate-700" />
            <span>Direct Pull Request</span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed font-sans">
            For developers: Fork the repository, add your Markdown file to <code class="text-cyan-800 bg-cyan-50 border border-cyan-200/80 px-1.5 py-0.5 rounded text-[11px] font-mono">src/content/tools/</code>, and open a Pull Request.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-950 font-mono text-[11px] text-cyan-300 border border-cyan-500/30 leading-relaxed shadow-2xs">
          git checkout -b add-my-tool<br />
          touch src/content/tools/my-tool.md<br />
          git commit -m "feat: add my tool"<br />
          git push origin add-my-tool
        </div>
      </div>
    </div>

    <!-- Frontmatter Generator -->
    <div class="p-6 sm:p-8 rounded-[28px] bg-white/90 backdrop-blur-xl border border-cyan-500/20 space-y-6 shadow-xs">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-base font-semibold text-slate-900 font-display">Interactive Markdown Generator</h2>
          <p class="text-xs text-slate-500 font-sans">Generate a schema-compliant Markdown file to copy into your submission</p>
        </div>
        <span class="text-xs font-mono text-cyan-700 bg-cyan-50 border border-cyan-200/70 px-2 py-0.5 rounded-md">Instant Preview</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">Software Title</label>
          <input
            id="page-gen-title"
            type="text"
            placeholder="e.g. Autokroma Influx"
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-xl px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none transition-all"
          />
        </div>

        <div>
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">Category</label>
          <select
            id="page-gen-category"
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 rounded-xl px-3 py-2 text-slate-700 focus:outline-none cursor-pointer transition-all"
          >
            {categories.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">One-Sentence Pitch (Tagline)</label>
          <input
            id="page-gen-tagline"
            type="text"
            placeholder="e.g. Native MKV and modern codec importer for Premiere & Resolve."
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-xl px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none transition-all"
          />
        </div>

        <div>
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">NLE Compatibility</label>
          <input
            id="page-gen-nle"
            type="text"
            placeholder="Premiere Pro, DaVinci Resolve"
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-xl px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none transition-all"
          />
        </div>

        <div>
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">Pricing Model</label>
          <select
            id="page-gen-pricing"
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 rounded-xl px-3 py-2 text-slate-700 focus:outline-none cursor-pointer transition-all"
          >
            <option value="Free">Free</option>
            <option value="Open-Source">Open-Source</option>
            <option value="One-Time" selected>One-Time</option>
            <option value="Subscription">Subscription</option>
            <option value="Freemium">Freemium</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">The Bottleneck</label>
          <textarea
            id="page-gen-bottleneck"
            rows="2"
            placeholder="What slows down the editor?"
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-xl px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none transition-all"
          ></textarea>
        </div>

        <div class="sm:col-span-2">
          <label class="block font-mono text-slate-600 mb-1 text-[11px]">The Solution</label>
          <textarea
            id="page-gen-solution"
            rows="2"
            placeholder="How does this tool solve it on the timeline?"
            class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-xl px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none transition-all"
          ></textarea>
        </div>
      </div>

      <!-- Code Output -->
      <div class="space-y-2 pt-4 border-t border-slate-100">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-cyan-700/80 uppercase">Live Output</span>
          <button
            id="page-copy-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs text-cyan-700 hover:text-cyan-900 bg-cyan-50 hover:bg-cyan-100/80 border border-cyan-200/80 rounded-lg font-medium transition-colors cursor-pointer"
          >
            <Copy class="w-3.5 h-3.5" />
            <span id="page-copy-label">Copy Code</span>
          </button>
        </div>
        <pre
          id="page-gen-preview"
          class="p-4 rounded-xl bg-slate-950 font-mono text-xs text-cyan-400 border border-cyan-500/30 overflow-x-auto select-all max-h-56"
        ></pre>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const preview = document.getElementById('page-gen-preview');
  const copyBtn = document.getElementById('page-copy-btn');
  const copyLabel = document.getElementById('page-copy-label');

  const titleInput = document.getElementById('page-gen-title') as HTMLInputElement | null;
  const categoryInput = document.getElementById('page-gen-category') as HTMLSelectElement | null;
  const taglineInput = document.getElementById('page-gen-tagline') as HTMLInputElement | null;
  const nleInput = document.getElementById('page-gen-nle') as HTMLInputElement | null;
  const pricingInput = document.getElementById('page-gen-pricing') as HTMLSelectElement | null;
  const bottleneckInput = document.getElementById('page-gen-bottleneck') as HTMLTextAreaElement | null;
  const solutionInput = document.getElementById('page-gen-solution') as HTMLTextAreaElement | null;

  function update() {
    if (!preview) return;
    const title = titleInput?.value.trim() || 'Software Name';
    const category = categoryInput?.value.trim() || 'Format Ingestion';
    const tagline = taglineInput?.value.trim() || 'One sentence pitch for this tool.';
    const nleList = (nleInput?.value.trim() || 'Premiere Pro, DaVinci Resolve')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    const pricing = pricingInput?.value.trim() || 'One-Time';
    const bottleneck = bottleneckInput?.value.trim() || 'The bottleneck...';
    const solution = solutionInput?.value.trim() || 'The solution...';

    const md = `---
title: "${title}"
tagline: "${tagline}"
type: "plugin"
category: "${category}"
nle_compatibility:
${nleList.map((n) => `  - "${n}"`).join('\n')}
os:
  - "macOS"
  - "Windows"
pricing: "${pricing}"
developer_type: "Indie"
website_url: "https://example.com"
icon: "film"
bottleneck: "${bottleneck}"
solution: "${solution}"
tags:
  - "editing"
---`;
    preview.textContent = md;
  }

  [titleInput, categoryInput, taglineInput, nleInput, pricingInput, bottleneckInput, solutionInput].forEach((el) => {
    el?.addEventListener('input', update);
  });

  update();

  if (copyBtn && preview && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(preview.textContent || '');
      copyLabel.textContent = 'Copied!';
      setTimeout(() => {
        copyLabel.textContent = 'Copy Code';
      }, 2000);
    });
  }
</script>
