---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { 
  ArrowLeft, ExternalLink, ArrowRight, Film, Zap, 
  Sparkles, Mic, Scissors, Disc, FolderOpen, Palette, 
  Terminal, Wrench, Share2
} from '@lucide/astro';
import GithubIcon from '../../components/GithubIcon.astro';
import SoftwareLogo from '../../components/SoftwareLogo.astro';
import PlatformIcons from '../../components/PlatformIcons.astro';
import { withBase } from '../../lib/path';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { data, id } = tool;
const { Content } = await render(tool);

// Related tools
const allTools = await getCollection('tools');
const relatedTools = allTools
  .filter((t) => t.id !== id && (t.data.category === data.category || t.data.nle_compatibility.some(n => data.nle_compatibility.includes(n))))
  .slice(0, 3);

// Icon mapping
const iconMap: Record<string, any> = {
  film: Film,
  zap: Zap,
  sparkles: Sparkles,
  mic: Mic,
  scissors: Scissors,
  disc: Disc,
  'folder-open': FolderOpen,
  palette: Palette,
  terminal: Terminal,
};
const IconComponent = iconMap[data.icon] || Wrench;
---

<BaseLayout
  title={`${data.title} — ${data.category} | Editors Den`}
  description={`${data.tagline} Bottleneck solved: ${data.bottleneck}`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <!-- Back to Archive Link -->
    <div>
      <a 
        href={withBase('/')} 
        class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-cyan-700 transition-colors"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Back to Archive</span>
      </a>
    </div>

    <!-- Tool Header Card -->
    <div class="p-6 sm:p-8 rounded-2xl bg-white/85 backdrop-blur-md border border-cyan-500/20 shadow-[0_8px_32px_rgba(14,165,233,0.06)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-16 h-16 rounded-2xl overflow-hidden shadow-md shrink-0 flex items-center justify-center">
          <SoftwareLogo id={id} name={data.title} class="w-16 h-16 rounded-2xl" loading="eager" fetchpriority="high" width={64} height={64} />
        </div>

        <div class="space-y-1.5">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 font-display tracking-tight">
              {data.title}
            </h1>
            {data.hidden_gem && (
              <span class="text-xs font-mono font-semibold text-amber-800 bg-amber-50 border border-amber-300/80 px-2.5 py-0.5 rounded-full inline-flex items-center gap-1 shadow-2xs">
                <span>Must Have (Recommended)</span>
                <span class="text-amber-600 font-bold">★</span>
              </span>
            )}
            <span class="text-xs font-mono text-slate-700 bg-slate-100/90 border border-slate-200 px-2.5 py-0.5 rounded-full">
              {data.pricing}
            </span>
          </div>

          <div class="flex items-center gap-2 text-xs text-slate-500">
            <span>{data.developer_type}</span>
            <span>·</span>
            <span>{data.category}</span>
            {data.price_detail && (
              <>
                <span>·</span>
                <span>{data.price_detail}</span>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Action Links -->
      <div class="flex items-center gap-2.5 sm:gap-3 w-full sm:w-auto flex-wrap sm:flex-nowrap">
        <button
          id="share-tool-btn"
          type="button"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-medium text-slate-700 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 border border-slate-200/80 rounded-full transition-colors cursor-pointer shadow-2xs w-full sm:w-auto"
          title="Share link to this tool"
        >
          <Share2 class="w-3.5 h-3.5 text-cyan-600" />
          <span id="share-tool-label">Share</span>
        </button>

        {data.website_url && (
          <a
            href={data.website_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2 text-xs font-medium text-white bg-slate-900 hover:bg-cyan-600 rounded-full transition-colors cursor-pointer w-full sm:w-auto shadow-xs"
          >
            <span>Visit Website</span>
            <ExternalLink class="w-3.5 h-3.5" />
          </a>
        )}
        {data.github_url && (
          <a
            href={data.github_url}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-500 hover:text-cyan-700 bg-white hover:bg-cyan-50 border border-cyan-500/20 rounded-full transition-colors shrink-0"
            title="GitHub Repository"
          >
            <GithubIcon class="w-4 h-4" />
          </a>
        )}
      </div>
    </div>

    <!-- Editorial Problem vs Solution Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- The Bottleneck -->
      <div class="p-6 rounded-2xl bg-rose-50/50 border border-rose-200/80 space-y-2.5 shadow-xs">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          <span class="text-xs font-mono uppercase tracking-wider text-rose-700 font-semibold">The Bottleneck</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
          {data.bottleneck}
        </p>
      </div>

      <!-- The Solution -->
      <div class="p-6 rounded-2xl bg-cyan-50/50 border border-cyan-200/80 space-y-2.5 shadow-xs">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-700 font-semibold">The Solution</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
          {data.solution}
        </p>
      </div>
    </div>

    <!-- Specifications Strip -->
    <div class="p-5 rounded-2xl bg-white/85 backdrop-blur-sm border border-cyan-500/20 flex flex-wrap items-center justify-between gap-4 text-xs shadow-xs">
      <div class="flex items-center gap-2 flex-wrap">
        {data.type === 'software' ? (
          <>
            <span class="text-indigo-700 font-mono text-[11px] font-semibold">Type:</span>
            <span class="px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700 font-sans text-xs font-semibold border border-indigo-200/80 shadow-2xs inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
              <span>Editing Software</span>
            </span>
          </>
        ) : data.type === 'utility' ? (
          <>
            <span class="text-sky-700 font-mono text-[11px] font-semibold">Type:</span>
            <span class="px-2.5 py-1 rounded-md bg-sky-50 text-sky-700 font-sans text-xs font-semibold border border-sky-200/80 shadow-2xs inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
              <span>Utility App</span>
            </span>
          </>
        ) : (
          <>
            <span class="text-emerald-700 font-mono text-[11px] font-semibold">Type:</span>
            <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 font-sans text-xs font-semibold border border-emerald-200/80 shadow-2xs inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Plugin</span>
            </span>
            {data.nle_compatibility.filter(n => n.toLowerCase() !== 'universal').length > 0 && (
              <>
                <span class="text-slate-400 font-mono text-[11px] ml-1">Works With:</span>
                {data.nle_compatibility.filter(n => n.toLowerCase() !== 'universal').map((nle) => (
                  <span class="px-2.5 py-1 rounded-md bg-slate-50 text-slate-700 font-sans text-xs font-medium border border-slate-200">
                    {nle}
                  </span>
                ))}
              </>
            )}
          </>
        )}
      </div>

      <div class="flex items-center gap-2 text-slate-500 font-mono text-[11px]">
        <span>Platforms:</span>
        <PlatformIcons os={data.os} />
      </div>
    </div>

    <!-- Markdown Overview & Breakdown -->
    <div class="p-8 rounded-2xl bg-white/80 backdrop-blur-sm border border-cyan-500/20 shadow-xs prose max-w-none text-sm text-slate-700 leading-relaxed prose-headings:text-slate-900 prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-a:text-cyan-600 prose-pre:bg-slate-950 prose-pre:text-slate-100 prose-pre:rounded-xl prose-pre:border prose-pre:border-cyan-500/20 prose-table:border prose-table:border-slate-200 prose-th:text-slate-800 prose-th:bg-slate-50 prose-td:border-slate-200">
      <Content />
    </div>

    <!-- Related Tools -->
    {relatedTools.length > 0 && (
      <div class="pt-8 border-t border-slate-200 space-y-4">
        <h2 class="text-sm font-semibold text-slate-900 font-display">Similar & Related Tools</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedTools.map((rel) => (
            <a
              href={withBase(`/tools/${rel.id}`)}
              class="p-5 sm:p-6 rounded-[24px] bg-white/90 backdrop-blur-md hover:bg-white border border-slate-100 shadow-[0_10px_30px_-10px_rgba(15,23,42,0.06)] hover:shadow-[0_20px_40px_-12px_rgba(15,23,42,0.1)] transition-all duration-300 flex flex-col justify-between group"
            >
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <div class="w-9 h-9 rounded-xl overflow-hidden shadow-2xs shrink-0 flex items-center justify-center transition-transform group-hover:scale-105">
                    <SoftwareLogo id={rel.id} name={rel.data.title} class="w-9 h-9 rounded-xl" loading="lazy" width={36} height={36} />
                  </div>
                  <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50/90 px-2 py-0.5 rounded-full border border-emerald-100/60 font-sans">
                    {rel.data.pricing}
                  </span>
                </div>
                <h3 class="font-bold text-sm text-slate-900 group-hover:text-cyan-700 transition-colors font-display">
                  {rel.data.title}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 font-sans leading-relaxed">
                  {rel.data.tagline}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const shareBtn = document.getElementById('share-tool-btn');
  const shareLabel = document.getElementById('share-tool-label');

  if (shareBtn && shareLabel) {
    shareBtn.addEventListener('click', async () => {
      try {
        if (navigator.share && window.matchMedia('(max-width: 768px)').matches) {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } else {
          await navigator.clipboard.writeText(window.location.href);
          shareLabel.textContent = 'Copied!';
          setTimeout(() => {
            shareLabel.textContent = 'Share';
          }, 2000);
        }
      } catch (_) {
        // User cancelled or clipboard fallback
      }
    });
  }
</script>
