---
interface Props {
  os: string[];
  class?: string;
}

const { os = [], class: className = '' } = Astro.props;

const hasApple = os.some((o) => ['macOS', 'iOS', 'iPadOS'].includes(o));
const hasWindows = os.includes('Windows');
const hasLinux = os.includes('Linux');
const hasAndroid = os.includes('Android');

const tooltipText = `Available on: ${os.join(', ')}`;
---

<div 
  class={`inline-flex items-center gap-1.5 px-2 py-1 rounded-lg bg-slate-100/80 hover:bg-slate-200/60 text-slate-500 hover:text-slate-800 transition-colors border border-slate-200/60 shrink-0 ${className}`}
  title={tooltipText}
>
  {hasApple && (
    <span title="macOS / iOS" class="inline-flex items-center">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <use href="#icon-os-apple" />
      </svg>
    </span>
  )}

  {hasWindows && (
    <span title="Windows" class="inline-flex items-center">
      <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <use href="#icon-os-windows" />
      </svg>
    </span>
  )}

  {hasLinux && (
    <span title="Linux" class="inline-flex items-center">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <use href="#icon-os-linux" />
      </svg>
    </span>
  )}

  {hasAndroid && (
    <span title="Android" class="inline-flex items-center">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <use href="#icon-os-android" />
      </svg>
    </span>
  )}
</div>
