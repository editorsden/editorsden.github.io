---
import { Plus, X, Copy, ExternalLink } from '@lucide/astro';
import GithubIcon from './GithubIcon.astro';

const categories = [
  'Format Ingestion',
  'Automation & AI',
  'Audio Repair & Cleanup',
  'Color Grading & VFX',
  'Workflow & Organization',
  'Subtitling & Transcription',
  'Export & Compression'
];
---

<dialog
  id="submit-tool-dialog"
  aria-label="Submit a Tool to Editors Den"
  aria-modal="true"
  class="fixed inset-0 m-auto w-full max-w-xl bg-white/95 backdrop-blur-xl border border-cyan-500/30 rounded-2xl shadow-[0_16px_48px_rgba(14,165,233,0.15)] p-0 text-slate-900 backdrop:bg-slate-900/30 backdrop:backdrop-blur-xs overflow-hidden outline-none"
>
  <div class="flex flex-col max-h-[85vh]">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-cyan-500/20">
      <div>
        <h2 class="text-base font-semibold text-slate-900 font-display">Submit a Tool or Script</h2>
        <p class="text-xs text-slate-500 font-sans">Contribute to the post-production archive</p>
      </div>
      <button
        id="close-submit-modal-btn"
        type="button"
        class="p-1.5 rounded-full text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer"
        aria-label="Close"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Content Body -->
    <div class="p-6 space-y-6 overflow-y-auto">
      <!-- GitHub Fast Track Box -->
      <div class="p-4 rounded-xl bg-cyan-50/50 border border-cyan-500/20 flex items-center justify-between gap-4">
        <div class="space-y-0.5">
          <div class="text-xs font-semibold text-slate-900 flex items-center gap-1.5 font-display">
            <GithubIcon class="w-4 h-4 text-slate-700" />
            <span>Submit via GitHub Form</span>
          </div>
          <p class="text-xs text-slate-500">Standardized issue template for quick review and merge.</p>
        </div>
        <a
          href="https://github.com/editorsden/editorsden.github.io/issues/new?template=tool_submission.yml"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-1 px-4 py-2 text-xs font-medium text-white bg-slate-900 hover:bg-cyan-600 rounded-full transition-colors shadow-xs"
        >
          <span>Open Form</span>
          <ExternalLink class="w-3 h-3" />
        </a>
      </div>

      <!-- Frontmatter Generator -->
      <div class="space-y-3.5 pt-1">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-900 font-display">Interactive Frontmatter Builder</span>
          <span class="text-[10px] font-mono text-cyan-700/70">src/content/tools/*.md</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">Title</label>
            <input
              id="gen-title"
              type="text"
              placeholder="e.g. Autokroma Influx"
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-lg px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">Category</label>
            <select
              id="gen-category"
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 rounded-lg px-3 py-2 text-slate-700 focus:outline-none cursor-pointer"
            >
              {categories.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">Tagline (One-sentence pitch)</label>
            <input
              id="gen-tagline"
              type="text"
              placeholder="e.g. Native MKV and modern codec importer for Premiere & Resolve."
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-lg px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">Compatible Software (e.g. Premiere, Resolve)</label>
            <input
              id="gen-nle"
              type="text"
              placeholder="Premiere Pro, DaVinci Resolve"
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-lg px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">Pricing Model</label>
            <select
              id="gen-pricing"
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 rounded-lg px-3 py-2 text-slate-700 focus:outline-none cursor-pointer"
            >
              <option value="Free">Free</option>
              <option value="Open-Source">Open-Source</option>
              <option value="One-Time" selected>One-Time</option>
              <option value="Subscription">Subscription</option>
              <option value="Freemium">Freemium</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">The Bottleneck</label>
            <textarea
              id="gen-bottleneck"
              rows="2"
              placeholder="What slows down the editor?"
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-lg px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none"
            ></textarea>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-[11px] text-slate-600 mb-1 font-mono">The Solution</label>
            <textarea
              id="gen-solution"
              rows="2"
              placeholder="How does this tool solve it on the timeline?"
              class="w-full bg-slate-50 border border-cyan-500/20 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 rounded-lg px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none"
            ></textarea>
          </div>
        </div>

        <!-- Markdown Output Box -->
        <div class="space-y-1.5 pt-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono text-cyan-700/80 uppercase">Generated Frontmatter</span>
            <button
              id="copy-generated-md-btn"
              type="button"
              class="inline-flex items-center gap-1 text-xs text-cyan-700 hover:text-cyan-900 font-medium transition-colors cursor-pointer"
            >
              <Copy class="w-3.5 h-3.5" />
              <span id="copy-btn-label">Copy Code</span>
            </button>
          </div>
          <pre
            id="generated-md-preview"
            class="p-3 rounded-xl bg-slate-950 text-cyan-400 border border-cyan-500/30 font-mono text-[11px] overflow-x-auto select-all max-h-36"
          ></pre>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('submit-tool-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-submit-modal-btn');
  const closeBtn = document.getElementById('close-submit-modal-btn');
  const preview = document.getElementById('generated-md-preview');
  const copyBtn = document.getElementById('copy-generated-md-btn');
  const copyLabel = document.getElementById('copy-btn-label');

  const titleInput = document.getElementById('gen-title') as HTMLInputElement | null;
  const categoryInput = document.getElementById('gen-category') as HTMLSelectElement | null;
  const taglineInput = document.getElementById('gen-tagline') as HTMLInputElement | null;
  const nleInput = document.getElementById('gen-nle') as HTMLInputElement | null;
  const pricingInput = document.getElementById('gen-pricing') as HTMLSelectElement | null;
  const bottleneckInput = document.getElementById('gen-bottleneck') as HTMLTextAreaElement | null;
  const solutionInput = document.getElementById('gen-solution') as HTMLTextAreaElement | null;

  function update() {
    if (!preview) return;
    const title = titleInput?.value.trim() || 'Tool Name';
    const category = categoryInput?.value.trim() || 'Format Ingestion';
    const tagline = taglineInput?.value.trim() || 'One-sentence pitch.';
    const nleList = (nleInput?.value.trim() || 'Premiere Pro, DaVinci Resolve')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    const pricing = pricingInput?.value.trim() || 'One-Time';
    const bottleneck = bottleneckInput?.value.trim() || 'The bottleneck...';
    const solution = solutionInput?.value.trim() || 'The solution...';

    const md = `---
title: "${title}"
tagline: "${tagline}"
type: "plugin"
category: "${category}"
nle_compatibility:
${nleList.map((n) => `  - "${n}"`).join('\n')}
os:
  - "macOS"
  - "Windows"
pricing: "${pricing}"
developer_type: "Indie"
website_url: "https://example.com"
icon: "film"
bottleneck: "${bottleneck}"
solution: "${solution}"
tags:
  - "editing"
---`;
    preview.textContent = md;
  }

  [titleInput, categoryInput, taglineInput, nleInput, pricingInput, bottleneckInput, solutionInput].forEach((el) => {
    el?.addEventListener('input', update);
  });

  update();

  if (openBtn && dialog) {
    openBtn.addEventListener('click', () => dialog.showModal());
  }

  if (closeBtn && dialog) {
    closeBtn.addEventListener('click', () => dialog.close());
  }

  if (copyBtn && preview && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(preview.textContent || '');
      copyLabel.textContent = 'Copied!';
      setTimeout(() => {
        copyLabel.textContent = 'Copy Code';
      }, 2000);
    });
  }

  if (dialog) {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  }
</script>
