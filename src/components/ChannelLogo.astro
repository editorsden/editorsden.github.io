---
interface Props {
  id: string;
  name?: string;
  class?: string;
  showBadge?: boolean;
}

import { withBase } from '../lib/path';

const { id, name = '', class: className = 'w-12 h-12 rounded-2xl', showBadge = true } = Astro.props;
const initialLetter = (name || id).charAt(0).toUpperCase();
const logoSrc = withBase(`/creators/${id}.jpg`);
---

<div class="relative shrink-0 inline-flex items-center justify-center">
  <div class={`relative shrink-0 flex items-center justify-center overflow-hidden bg-slate-900 border border-slate-100/90 shadow-[0_2px_8px_rgba(15,23,42,0.06)] ${className}`}>
    <img 
      src={logoSrc} 
      alt={`${name || id} YouTube channel logo`} 
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <div class="w-full h-full bg-gradient-to-br from-slate-900 to-slate-800 text-white hidden items-center justify-center font-display font-bold text-sm select-none">
      {initialLetter}
    </div>
  </div>
  {showBadge && (
    <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full bg-red-600 text-white flex items-center justify-center shadow-xs border-[1.5px] border-white pointer-events-none" title="YouTube Channel">
      <svg class="w-2.5 h-2.5 fill-white" viewBox="0 0 24 24">
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
    </div>
  )}
</div>
