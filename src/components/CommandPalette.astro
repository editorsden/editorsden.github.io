---
import { Search } from '@lucide/astro';
---

<dialog
  id="command-palette-dialog"
  aria-label="Command Palette Search"
  aria-modal="true"
  class="fixed inset-0 m-auto w-full max-w-xl bg-white/95 backdrop-blur-xl border border-cyan-500/30 rounded-2xl shadow-[0_16px_48px_rgba(14,165,233,0.15)] p-0 text-slate-900 backdrop:bg-slate-900/30 backdrop:backdrop-blur-xs overflow-hidden outline-none"
>
  <div class="flex flex-col max-h-[80vh]">
    <!-- Search Bar -->
    <div class="flex items-center px-4 py-3.5 border-b border-cyan-500/20 gap-3">
      <Search class="w-4 h-4 text-cyan-500 shrink-0" />
      <input
        id="palette-search-input"
        type="text"
        placeholder="Type a tool, script, or bottleneck (e.g. 'prores', 'mkv', 'silence', 'excalibur')..."
        class="w-full bg-transparent text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="px-2 py-0.5 text-[10px] font-mono text-cyan-700 bg-cyan-50/80 border border-cyan-200/80 rounded-md shrink-0">
        ESC
      </kbd>
    </div>

    <!-- Results List -->
    <div id="palette-results-list" class="flex-1 overflow-y-auto p-2 space-y-1">
      <!-- Injected via JavaScript -->
    </div>

    <!-- Footer Status -->
    <div class="px-4 py-2.5 bg-slate-50/80 border-t border-cyan-500/20 flex items-center justify-between text-[11px] text-cyan-700/80 font-mono">
      <div class="flex items-center gap-3">
        <span>↑↓ Navigate</span>
        <span>↵ Select</span>
      </div>
      <span>Editors Den Fast Search</span>
    </div>
  </div>
</dialog>

<script>
  import { withBase } from '../lib/path';

  const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('palette-search-input') as HTMLInputElement | null;
  const resultsList = document.getElementById('palette-results-list');
  const triggerBtn = document.getElementById('search-palette-trigger');

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  interface SearchItem {
    id: string;
    url: string;
    title: string;
    tagline: string;
    category: string;
    pricing: string;
    bottleneck: string;
    solution: string;
    tags: string[];
  }

  let tools: SearchItem[] = [];
  let fuseInstance: any = null;
  let loadPromise: Promise<any> | null = null;
  let selectedIndex = 0;
  let currentResults: SearchItem[] = [];
  let pendingQuery = '';

  async function initSearch() {
    if (fuseInstance) return fuseInstance;
    if (loadPromise) return loadPromise;

    loadPromise = (async () => {
      try {
        const [{ default: Fuse }, res] = await Promise.all([
          import('fuse.js'),
          fetch(withBase('/search-index.json'))
        ]);
        tools = await res.json();
        fuseInstance = new Fuse(tools, {
          keys: [
            { name: 'title', weight: 0.35 },
            { name: 'bottleneck', weight: 0.25 },
            { name: 'solution', weight: 0.2 },
            { name: 'tags', weight: 0.1 },
            { name: 'category', weight: 0.1 },
          ],
          threshold: 0.35,
          distance: 100,
        });
        return fuseInstance;
      } catch (err) {
        console.error('Failed to load search index:', err);
        return null;
      }
    })();

    return loadPromise;
  }

  function openPalette(initialQuery = '') {
    if (!dialog) return;
    dialog.showModal();
    if (input) {
      input.value = initialQuery;
      input.focus();
      input.select();
    }
    pendingQuery = initialQuery;

    if (!fuseInstance) {
      if (resultsList) {
        resultsList.innerHTML = `
          <div class="py-8 text-center text-slate-400 text-xs font-sans">
            Loading search index...
          </div>
        `;
      }
      initSearch().then(() => {
        renderResults(input?.value || pendingQuery);
      });
    } else {
      renderResults(initialQuery);
    }
  }

  function closePalette() {
    if (!dialog) return;
    dialog.close();
  }

  function renderResults(query: string) {
    if (!resultsList) return;
    if (!fuseInstance) {
      pendingQuery = query;
      return;
    }

    const trimmed = query.trim();

    if (!trimmed) {
      currentResults = tools.slice(0, 5);
    } else {
      const searchRes = fuseInstance.search(trimmed);
      currentResults = searchRes.map((r: any) => r.item);
    }

    selectedIndex = 0;

    if (currentResults.length === 0) {
      resultsList.innerHTML = `
        <div class="py-10 text-center text-slate-400 text-xs font-sans">
          No tools or scripts found matching "${escapeHtml(trimmed)}"
        </div>
      `;
      return;
    }

    resultsList.innerHTML = currentResults
      .map((tool, idx) => {
        const isSelected = idx === selectedIndex;
        return `
          <a
            href="${tool.url}"
            data-index="${idx}"
            class="palette-result-item block px-3.5 py-2.5 rounded-xl transition-colors cursor-pointer ${
              isSelected ? 'bg-cyan-500/10 border border-cyan-500/30' : 'hover:bg-slate-50'
            }"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-slate-900 font-display">${escapeHtml(tool.title)}</span>
              <div class="flex items-center gap-1.5 text-[10px] font-mono text-cyan-700/80">
                <span>${escapeHtml(tool.category)}</span>
                <span>·</span>
                <span>${escapeHtml(tool.pricing)}</span>
              </div>
            </div>
            <p class="text-xs text-slate-500 truncate mt-0.5">${escapeHtml(tool.tagline)}</p>
          </a>
        `;
      })
      .join('');

    attachListeners();
  }

  function attachListeners() {
    if (!resultsList) return;
    const items = resultsList.querySelectorAll('.palette-result-item');
    items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const idx = Number(item.getAttribute('data-index'));
        updateSelection(idx);
      });
    });
  }

  function updateSelection(newIndex: number) {
    if (!resultsList) return;
    const items = resultsList.querySelectorAll('.palette-result-item');
    if (newIndex < 0) newIndex = items.length - 1;
    if (newIndex >= items.length) newIndex = 0;
    selectedIndex = newIndex;

    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-cyan-500/10', 'border', 'border-cyan-500/30');
      } else {
        item.classList.remove('bg-cyan-500/10', 'border', 'border-cyan-500/30');
      }
    });

    const activeItem = items[selectedIndex] as HTMLElement | undefined;
    if (activeItem) {
      activeItem.scrollIntoView({ block: 'nearest' });
    }
  }

  if (input) {
    input.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateSelection(selectedIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateSelection(selectedIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (currentResults[selectedIndex]) {
          window.location.href = currentResults[selectedIndex].url;
        }
      }
    });
  }

  if (dialog) {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        closePalette();
      }
    });
  }

  if (triggerBtn) {
    triggerBtn.addEventListener('click', () => openPalette());
    // Preload search index on hover or focus of search button
    triggerBtn.addEventListener('pointerenter', () => initSearch(), { once: true });
    triggerBtn.addEventListener('focus', () => initSearch(), { once: true });
  }

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (dialog && dialog.open) {
        closePalette();
      } else {
        openPalette();
      }
    }
  });
</script>
