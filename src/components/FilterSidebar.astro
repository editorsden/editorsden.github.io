---
import { Search, RotateCcw, SlidersHorizontal, Sparkles, BookOpen, Film, Layers, LayoutGrid, List } from '@lucide/astro';

const nleList = [
  'Premiere Pro',
  'DaVinci Resolve',
  'After Effects',
  'Final Cut Pro',
  'Avid Media Composer',
  'Blender',
];

const learningNiches = [
  'Premiere Pro',
  'After Effects',
  'Motion Design',
  'Filmmaking',
  'Music',
  'VFX',
  '3D'
];

const categoryList = [
  'Video Editing',
  'Format Ingestion',
  'Automation & AI',
  'Audio Repair & Cleanup',
  'Color Grading & VFX',
  'Workflow & Organization',
  'Subtitling & Transcription',
  'Export & Compression'
];
---

<!-- Sticky Filter Sidebar Container -->
<div class="w-full">
  <!-- Mobile Filter Toggle Bar (Visible on < lg) -->
  <div class="lg:hidden flex items-center justify-between gap-3 mb-4 bg-white/90 backdrop-blur-md p-3 rounded-2xl border border-slate-200/80 shadow-xs">
    <button
      id="mobile-filters-trigger"
      type="button"
      class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900 text-white text-xs font-medium cursor-pointer transition-all shadow-xs"
    >
      <SlidersHorizontal class="w-3.5 h-3.5 text-cyan-400" />
      <span>Filters & Search</span>
      <span id="mobile-filter-count-badge" class="hidden text-[10px] font-mono bg-cyan-500 text-slate-950 font-bold px-1.5 py-0.2 rounded-full">
        0
      </span>
    </button>

    <div class="text-xs text-slate-500 font-mono" id="mobile-tool-count">
      39 tools
    </div>
  </div>

  <!-- Sidebar Filter Panel: Sticky on Desktop, Collapsible Drawer on Mobile -->
  <div 
    id="filter-sidebar-panel"
    class="hidden lg:block bg-white/90 backdrop-blur-xl border border-slate-200/80 rounded-[28px] p-5 shadow-[0_10px_30px_-10px_rgba(15,23,42,0.05)] space-y-5 max-h-[calc(100vh-7.5rem)] overflow-y-auto scrollbar-thin scrollbar-thumb-slate-200"
  >
    <!-- Top Header & Reset Button -->
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div class="flex items-center gap-2">
        <SlidersHorizontal class="w-4 h-4 text-cyan-600" />
        <span class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">Filters</span>
      </div>
      
      <button
        id="clear-filters-btn"
        type="button"
        class="hidden items-center gap-1 text-[11px] font-mono text-rose-600 hover:text-rose-700 bg-rose-50/80 hover:bg-rose-100/80 px-2 py-0.5 rounded-md transition-colors cursor-pointer"
        title="Reset all active filters"
      >
        <RotateCcw class="w-2.5 h-2.5" />
        <span>Reset</span>
      </button>
    </div>

    <!-- Search Input -->
    <div class="space-y-1.5">
      <label for="filter-search-input" class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Search Archive
      </label>
      <div class="relative">
        <input
          id="filter-search-input"
          type="text"
          placeholder="Keyword, software, feature..."
          class="w-full bg-slate-50/90 hover:bg-white focus:bg-white border border-slate-200/90 focus:border-cyan-500 rounded-xl px-3 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/15 pl-8 pr-12 transition-all"
        />
        <Search class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5 pointer-events-none" />
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.2 text-[9px] font-mono text-slate-500 bg-slate-100 border border-slate-200/80 rounded absolute right-2.5 top-2 pointer-events-none">
          /
        </kbd>
      </div>
    </div>

    <!-- Directory Section Tabs (All Tools, Softwares, Plugins, Tutorials, Gems) -->
    <div class="space-y-2">
      <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Directory View
      </label>
      <div class="space-y-1" id="type-tabs-container">
        <button
          type="button"
          data-tab-type=""
          class="type-tab-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-slate-900 text-white shadow-xs font-sans"
        >
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>All Tools & Softwares</span>
          </div>
        </button>

        <button
          type="button"
          data-tab-type="software"
          class="type-tab-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-transparent hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-transparent hover:border-slate-200/60 font-sans"
        >
          <div class="flex items-center gap-2">
            <Film class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-600" />
            <span>Editing Softwares</span>
          </div>
          <span class="text-[10px] font-mono text-slate-400">Suites</span>
        </button>

        <button
          type="button"
          data-tab-type="gems"
          class="type-tab-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-transparent hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-transparent hover:border-slate-200/60 font-sans"
        >
          <div class="flex items-center gap-2">
            <Sparkles class="w-3.5 h-3.5 text-amber-500" />
            <span>Must Have Utilities</span>
          </div>
          <span class="gems-star w-4 h-4 rounded-full bg-amber-50 text-amber-600 text-[10px] flex items-center justify-center font-bold">★</span>
        </button>

        <button
          type="button"
          data-tab-type="plugin"
          class="type-tab-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-transparent hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-transparent hover:border-slate-200/60 font-sans"
        >
          <div class="flex items-center gap-2">
            <Layers class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-600" />
            <span>Plugins</span>
          </div>
          <span class="text-[10px] font-mono text-slate-400">Ext</span>
        </button>

        <button
          type="button"
          data-tab-type="tutorial"
          class="type-tab-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-transparent hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-transparent hover:border-slate-200/60 font-sans"
        >
          <div class="flex items-center gap-2">
            <BookOpen class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-600" />
            <span>Learning</span>
          </div>
          <span class="tutorial-guide-badge text-[10px] font-mono text-cyan-600">Guides</span>
        </button>
      </div>
    </div>

    <!-- View Mode (Cards vs List) Toggle inside Filters -->
    <div class="space-y-1.5">
      <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        View Layout
      </label>
      <div class="grid grid-cols-2 gap-1.5 bg-slate-100/90 p-1 rounded-xl border border-slate-200/60" id="view-mode-toggle-group">
        <button
          id="view-mode-grid"
          type="button"
          class="view-mode-btn py-1.5 px-3 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-900 text-white shadow-xs flex items-center justify-center gap-1.5 font-sans"
          title="Card Grid Mode"
        >
          <LayoutGrid class="w-3.5 h-3.5" />
          <span>Cards</span>
        </button>
        <button
          id="view-mode-list"
          type="button"
          class="view-mode-btn py-1.5 px-3 rounded-lg text-xs font-medium transition-all cursor-pointer text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 font-sans"
          title="Compact List Mode"
        >
          <List class="w-3.5 h-3.5" />
          <span>List</span>
        </button>
      </div>
    </div>

    <!-- Contextual Section 1: Operating System & Platform (Prominent with verified icons) -->
    <div id="sidebar-context-os" class="space-y-2">
      <div class="flex items-center justify-between">
        <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
          Platform / Operating System
        </label>
        <span id="active-os-label" class="hidden text-[10px] font-mono text-cyan-700 bg-cyan-50 px-1.5 py-0.5 rounded font-medium"></span>
      </div>
      <div class="grid grid-cols-2 gap-1.5" id="os-pill-group">
        <button
          type="button"
          data-filter-os=""
          class="os-pill col-span-2 py-1.5 px-2.5 rounded-xl text-xs font-medium bg-slate-900 text-white flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-2xs font-sans"
        >
          <span>All Platforms</span>
        </button>
        <button
          type="button"
          data-filter-os="macOS"
          class="os-pill py-1.5 px-2.5 rounded-xl text-xs font-medium bg-slate-50 hover:bg-white text-slate-700 hover:text-slate-900 border border-slate-200/70 shadow-2xs flex items-center gap-1.5 transition-all cursor-pointer font-sans"
          title="Filter for macOS tools"
        >
          <!-- Apple Logo -->
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 170 170">
            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.6-7.77-11.72-14.19-5.99-9.35-10.74-19.89-14.25-31.62-3.52-11.73-5.28-22.75-5.28-33.05 0-14.65 3.69-26.79 11.06-36.43 7.37-9.64 16.5-14.54 27.39-14.7 4.89 0 10.15 1.25 15.77 3.75 5.63 2.5 9.4 3.76 11.32 3.76 1.7 0 5.62-1.34 11.76-4.02 6.13-2.68 11.45-3.89 15.96-3.62 12.37.64 22.37 5.17 30 13.59-10.87 6.63-16.19 15.54-15.96 26.72.24 8.79 3.58 16.03 10.02 21.72 6.44 5.69 13.98 9.06 22.61 10.1-2.12 6.27-4.78 12.57-7.98 18.9zm-31.98-106.84c0-7.04 2.58-13.5 7.73-19.38 5.16-5.88 11.48-9.46 18.96-10.74.22 1.06.33 2.02.33 2.87 0 6.93-2.6 13.35-7.8 19.26-5.2 5.92-11.6 9.47-19.22 10.66z"/>
          </svg>
          <span>macOS</span>
        </button>
        <button
          type="button"
          data-filter-os="Windows"
          class="os-pill py-1.5 px-2.5 rounded-xl text-xs font-medium bg-slate-50 hover:bg-white text-slate-700 hover:text-slate-900 border border-slate-200/70 shadow-2xs flex items-center gap-1.5 transition-all cursor-pointer font-sans"
          title="Filter for Windows tools"
        >
          <!-- Windows Logo -->
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 88 88">
            <path d="M0 12.402l35.687-4.86.016 34.423-35.67.202zm35.67 33.529l.028 34.453L.028 75.48.016 45.729zm4.326-39.027L87.914 0v41.525l-47.918.277zm47.918 39.529v41.537l-47.918-6.76V46.661z"/>
          </svg>
          <span>Windows</span>
        </button>
        <button
          type="button"
          data-filter-os="Linux"
          class="os-pill py-1.5 px-2.5 rounded-xl text-xs font-medium bg-slate-50 hover:bg-white text-slate-700 hover:text-slate-900 border border-slate-200/70 shadow-2xs flex items-center gap-1.5 transition-all cursor-pointer font-sans"
          title="Filter for Linux tools"
        >
          <!-- Linux Tux Logo -->
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 00-.12.27.944.944 0 00-.023.33v.015c.012.135.037.2.08.334.046.134.098.2.166.268.01.009.02.018.034.024-.07.057-.117.07-.176.136a.304.304 0 01-.131.068 2.62 2.62 0 01-.275-.402 1.772 1.772 0 01-.155-.667 1.759 1.759 0 01.08-.668 1.43 1.43 0 01.283-.535c.128-.133.26-.2.418-.2zm1.37 1.706c.332 0 .733.065 1.216.399.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.571.571 0 01.016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465-.276.135-.588.292-1.012.267a1.139 1.139 0 01-.448-.067 3.566 3.566 0 01-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71-.07-.268-.005-.47.193-.6.224-.135.38-.271.483-.336.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473.286.534.855 1.659 1.102 3.024.156-.005.33.018.513.064.646-1.671-.546-3.467-1.089-3.966-.22-.2-.232-.335-.123-.335.59.534 1.365 1.572 1.646 2.757.13.535.16 1.104.021 1.67.067.028.135.06.205.067 1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224-.915-.4-1.646-.336-1.77.465-.008.043-.013.066-.018.135-.068.023-.139.053-.209.064-.43.268-.662.669-.793 1.187-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35-1.5 1.072-3.58 1.538-5.348.334a2.645 2.645 0 00-.402-.533 1.45 1.45 0 00-.275-.333c.182 0 .338-.03.465-.067a.615.615 0 00.314-.334c.108-.267 0-.697-.345-1.163-.345-.467-.931-.995-1.788-1.521-.63-.4-.986-.87-1.15-1.396-.165-.534-.143-1.085-.015-1.645.245-1.07.873-2.11 1.274-2.763.107-.065.037.135-.408.974-.396.751-1.14 2.497-.122 3.854a8.123 8.123 0 01.647-2.876c.564-1.278 1.743-3.504 1.836-5.268.048.036.217.135.289.202.218.133.38.333.59.465.21.201.477.335.876.335.039.003.075.006.11.006.412 0 .73-.134.997-.268.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/>
          </svg>
          <span>Linux</span>
        </button>
        <button
          type="button"
          data-filter-os="Mobile"
          class="os-pill py-1.5 px-2.5 rounded-xl text-xs font-medium bg-slate-50 hover:bg-white text-slate-700 hover:text-slate-900 border border-slate-200/70 shadow-2xs flex items-center gap-1.5 transition-all cursor-pointer font-sans"
          title="Filter for Mobile tools (iOS / Android / iPadOS)"
        >
          <!-- Mobile Device Icon -->
          <svg class="w-3.5 h-3.5 fill-none stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
          <span>Mobile</span>
        </button>
      </div>
    </div>

    <!-- Contextual Section 2: Compatible Host NLE (Visible for Plugins & All Tools; Hidden for Softwares & Learning) -->
    <div id="sidebar-context-nle" class="space-y-2">
      <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Compatible Host NLE
      </label>
      <div class="flex flex-wrap gap-1.5" id="nle-pill-group">
        <button
          type="button"
          data-filter-nle=""
          class="nle-pill px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-900 text-white font-sans"
        >
          All Software
        </button>
        {nleList.map((nle) => (
          <button
            type="button"
            data-filter-nle={nle}
            class="nle-pill px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-50 hover:bg-white text-slate-600 hover:text-slate-900 border border-slate-200/70 shadow-2xs font-sans"
          >
            {nle}
          </button>
        ))}
      </div>
    </div>

    <!-- Contextual Section 3: Learning Specializations (Visible only when Learning tab is active) -->
    <div id="sidebar-context-learning" class="space-y-2 hidden">
      <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Learning Topics
      </label>
      <div class="flex flex-wrap gap-1.5" id="sidebar-learning-niches">
        <button
          type="button"
          data-niche=""
          class="sidebar-niche-btn px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-900 text-white font-sans"
        >
          All Topics
        </button>
        {learningNiches.map((niche) => (
          <button
            type="button"
            data-niche={niche}
            class="sidebar-niche-btn px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-slate-50 hover:bg-white text-slate-600 hover:text-slate-900 border border-slate-200/70 shadow-2xs font-sans"
          >
            {niche}
          </button>
        ))}
      </div>
    </div>

    <!-- Contextual Section 4: Tool Category Filter (Hidden in Learning) -->
    <div id="sidebar-context-category" class="space-y-1.5">
      <label for="filter-category-select" class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Category
      </label>
      <div class="relative">
        <select
          id="filter-category-select"
          class="w-full appearance-none bg-slate-50/90 hover:bg-white focus:bg-white border border-slate-200/90 focus:border-cyan-500 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-500/15 cursor-pointer transition-all pr-8"
        >
          <option value="">All Categories & Niches</option>
          <optgroup label="Learning & Creator Topics">
            {learningNiches.map((niche) => (
              <option value={niche}>{niche}</option>
            ))}
          </optgroup>
          <optgroup label="Software & Tool Categories">
            {categoryList.map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </optgroup>
        </select>
        <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Contextual Section 5: Pricing Model Filter (Hidden in Learning) -->
    <div id="sidebar-context-pricing" class="space-y-1.5">
      <label for="filter-pricing-select" class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block">
        Pricing Model
      </label>
      <div class="relative">
        <select
          id="filter-pricing-select"
          class="w-full appearance-none bg-slate-50/90 hover:bg-white focus:bg-white border border-slate-200/90 focus:border-cyan-500 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-500/15 cursor-pointer transition-all pr-8"
        >
          <option value="">All Pricing Models</option>
          <option value="Free">Free & Open-Source</option>
          <option value="Freemium">Freemium</option>
          <option value="One-Time">One-Time Purchase</option>
          <option value="Subscription">Subscription</option>
        </select>
        <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>
